# recommendation-service environment contract
#
# Copy this file to .env for local development.
# Do not commit real secrets.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

APP_ENV=local
APP_NAME=recommendation-service
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=recommendation_service
POSTGRES_USER=recommendation_user
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql+psycopg://recommendation_user:change_me_local_only@localhost:5432/recommendation_service

# -----------------------------------------------------------------------------
# Qdrant
# -----------------------------------------------------------------------------

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_BEVERAGE_COLLECTION=beverage_vectors_v1
QDRANT_VENUE_COLLECTION=venue_vectors_v1
QDRANT_MENU_ITEM_COLLECTION=menu_item_vectors_v1

# -----------------------------------------------------------------------------
# Auth Service
# -----------------------------------------------------------------------------

# recommendation-service verifies identity. It does not issue JWTs.
AUTH_SERVICE_URL=http://localhost:8081
AUTH_JWKS_URL=http://localhost:8081/.well-known/jwks.json
JWT_ISSUER=on-the-block-auth
JWT_AUDIENCE=recommendation-service

# -----------------------------------------------------------------------------
# Survey Service
# -----------------------------------------------------------------------------

# Use survey-service APIs/events only. Do not configure direct survey DB access.
SURVEY_SERVICE_URL=http://localhost:8082
SURVEY_EVENTS_POLL_INTERVAL_SECONDS=10
SURVEY_EVENTS_PAGE_SIZE=100

# -----------------------------------------------------------------------------
# Sync and Rebuild
# -----------------------------------------------------------------------------

SYNC_WORKER_ENABLED=true
SYNC_MAX_ATTEMPTS=5
SYNC_RETRY_BASE_SECONDS=30
PROFILE_REGENERATION_ENABLED=true
QDRANT_INDEXING_ENABLED=true

# -----------------------------------------------------------------------------
# Recommendation Defaults
# -----------------------------------------------------------------------------

DEFAULT_RECOMMENDATION_LIMIT=20
DEFAULT_VENUE_RADIUS_METERS=3000
ACTIVE_VECTOR_SCHEMA=taste_v1
ACTIVE_SURVEY_MAPPER=survey_mapper_v1
ACTIVE_SCORING_CONFIG=scoring_v1

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------

REQUEST_ID_HEADER=X-Request-ID
STRUCTURED_LOGS=true
